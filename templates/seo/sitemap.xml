<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
    <url>
        <loc>{{ request.scheme }}://{{ request.get_host }}/</loc>
        <xhtml:link rel="alternate" hreflang="fr" href="{{ request.scheme }}://{{ request.get_host }}/fr/"/>
        <xhtml:link rel="alternate" hreflang="en" href="{{ request.scheme }}://{{ request.get_host }}/en/"/>
        <changefreq>daily</changefreq>
        <priority>1.0</priority>
    </url>
    <url>
        <loc>{{ request.scheme }}://{{ request.get_host }}/fr/blog/</loc>
        <xhtml:link rel="alternate" hreflang="en" href="{{ request.scheme }}://{{ request.get_host }}/en/blog/"/>
        <changefreq>daily</changefreq>
        <priority>0.8</priority>
    </url>
    <url>
        <loc>{{ request.scheme }}://{{ request.get_host }}/fr/boutique/</loc>
        <xhtml:link rel="alternate" hreflang="en" href="{{ request.scheme }}://{{ request.get_host }}/en/boutique/"/>
        <changefreq>daily</changefreq>
        <priority>0.9</priority>
    </url>
</urlset>
