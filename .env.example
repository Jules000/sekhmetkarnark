# ============================================================
# ENVIRONNEMENT : local | production
# ============================================================
DJANGO_ENV=local

# ============================================================
# DJANGO CORE
# ============================================================
SECRET_KEY=generate-with-python-secrets
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================================
# BASE DE DONNÉES
# Décommenter le bloc correspondant à l'environnement actif
# ============================================================

# --- LOCAL PostgreSQL ---
DB_ENGINE=django.db.backends.postgresql
DB_NAME=sekhmetkarnak
DB_USER=postgres
DB_PASSWORD=your_local_password
DB_HOST=localhost
DB_PORT=5432

# --- RAILWAY PostgreSQL (remplir avant déploiement) ---
# DATABASE_URL=postgresql://user:password@host:port/dbname

# ============================================================
# REDIS
# ============================================================
REDIS_URL=redis://localhost:6379/0

# ============================================================
# MÉDIAS & CDN
# ============================================================
USE_S3=False
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
CDN_DOMAIN=

# ============================================================
# PAIEMENT TRANZAK
# ============================================================
TRANZAK_MODE=sandbox

# Sandbox Credentials (used when TRANZAK_MODE=sandbox)
TRANZAK_SANDBOX_APP_ID=
TRANZAK_SANDBOX_APP_KEY=
TRANZAK_SANDBOX_WEBHOOK_SECRET=

# Live Credentials (used when TRANZAK_MODE=live)
TRANZAK_LIVE_APP_ID=
TRANZAK_LIVE_APP_KEY=
TRANZAK_LIVE_WEBHOOK_SECRET=

# ============================================================
# EMAIL — BREVO
# ============================================================
BREVO_API_KEY=
DEFAULT_FROM_EMAIL=contact@sekhmetkarnak.com
CONTACT_EMAIL_ADMIN=admin@sekhmetkarnak.com

# ============================================================
# SÉCURITÉ
# ============================================================
RECAPTCHA_PUBLIC_KEY=
RECAPTCHA_PRIVATE_KEY=
FIELD_ENCRYPTION_KEY=

# ============================================================
# MONITORING
# ============================================================
SENTRY_DSN=
